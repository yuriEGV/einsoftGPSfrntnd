# API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=30000

# Socket.io Configuration
VITE_SOCKET_URL=http://localhost:5000
VITE_SOCKET_RECONNECTION_DELAY=1000

# Mapbox Configuration
# Get a free token at: https://account.mapbox.com/tokens/
# For development, you can use a restricted public token
VITE_MAPBOX_TOKEN=pk_test_development
# Replace above with your actual token: VITE_MAPBOX_TOKEN=pk_YOUR_PUBLIC_TOKEN

# App Configuration
VITE_APP_NAME=Einsoft GPS
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true

# Monitoring
VITE_SENTRY_DSN=

# Maps
VITE_MAP_CENTER_LAT=-33.8688
VITE_MAP_CENTER_LNG=-51.2093
VITE_MAP_ZOOM=12
